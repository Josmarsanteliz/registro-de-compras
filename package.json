{
  "name": "registro-compras",
  "productName": "Registro de Compras",
  "version": "1.2.0",
  "description": "Registro personal de compras, conversiones y préstamos en BTC, USDT, USD y Bs, con tasa del BCV automática. 100% local.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test-core.js",
    "smoke": "electron smoke.js",
    "dist": "electron-builder --win"
  },
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.hogar.registrocompras",
    "productName": "Registro de Compras",
    "files": [
      "main.js",
      "preload.js",
      "core.js",
      "bcv.js",
      "renderer/**/*",
      "Logo/PNG.png",
      "Logo/app.ico",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "Logo/app.ico",
      "signExecutable": false
    },
    "electronLanguages": [
      "es",
      "en-US"
    ],
    "compression": "maximum",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Registro de Compras",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Registro-de-Compras-Setup.exe",
      "differentialPackage": false
    }
  }
}